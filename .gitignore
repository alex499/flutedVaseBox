# Render output — generated from the .scad source
*.stl
*.3mf
*.png

# Reference source mesh, used only for measurements. Not ours to redistribute.
reference/

# Customizer presets, written by the OpenSCAD GUI next to the .scad
flutedvasebox.json

# Web configurator — dependencies and the assembled site, both rebuilt by `node build.js`
web/node_modules/
web/_site/

# Local tool settings
.claude/settings.local.json
